<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/rynthv_icon"
        android:label="${appLabel}"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name="org.rynthv.app.RynthVActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="rynthv_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_paths" />
        </provider>
    </application>
</manifest>
