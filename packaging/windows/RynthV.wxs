<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RynthV" Manufacturer="RynthV Contributors"
           Version="$(var.ProductVersion)" UpgradeCode="$(var.ProductUpgradeCode)"
           Scope="perMachine" Language="1033">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RynthV is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="RynthV" />
    </StandardDirectory>
    <ComponentGroup Id="RynthVFiles" Directory="INSTALLFOLDER">
      <Component Id="EditorExecutable" Guid="*">
        <File Id="EditorExe" Source="$(var.BinaryDir)\rynthv.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder"
                    Name="RynthV" Advertise="yes" WorkingDirectory="INSTALLFOLDER" />
        </File>
      </Component>
      <Component Id="SynthesisExecutable" Guid="*">
        <File Id="SynthExe" Source="$(var.BinaryDir)\rynthv-synth.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
    <Feature Id="Complete" Title="RynthV" Level="1">
      <ComponentGroupRef Id="RynthVFiles" />
    </Feature>
  </Package>
</Wix>
